# Copy to .env for local development. Values in Vercel drive production.
# The database var name is matched case-insensitively and the value is
# sanitized (see lib/db/url.ts), but the clean form is:
DATABASE_URL=postgresql://user:password@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require

# Booking emails (silent no-op while unset)
RESEND_API_KEY=
# RESEND_FROM="Crossroads Wedding Co. <jake@crossroadsweddingco.com>"
# RESEND_NOTIFY_TO=jake@crossroadsweddingco.com

# Booking texts via Twilio (silent no-op while unset). Sender is either a
# Messaging Service SID (preferred once A2P/toll-free registration exists)
# or a bare From number in E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=+18125550100
# TWILIO_NOTIFY_TO=+18129163952

# Deposit payments (fail closed with 501 while unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Spotify playlist ingestion + track search (fails closed while unset)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Shared secret for internal tooling endpoints
ADMIN_API_TOKEN=

# Intro-call booking page (card renders nothing while unset)
NEXT_PUBLIC_BOOKING_URL=

# IG Studio
IG_STUDIO_TOKEN=
ANTHROPIC_API_KEY=
UNSPLASH_ACCESS_KEY=

# Calls in the hub, on Daily.co (renders nothing at all while unset).
# Free tier is 10,000 participant-minutes a month. DAILY_DOMAIN is the
# subdomain from the Daily dashboard, e.g. crossroads.daily.co
DAILY_API_KEY=
DAILY_DOMAIN=
