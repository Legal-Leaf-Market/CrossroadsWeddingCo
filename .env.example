# Copy to .env for local development. Values in Vercel drive production.
# The database var name is matched case-insensitively and the value is
# sanitized (see lib/db/url.ts), but the clean form is:
DATABASE_URL=postgresql://user:password@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require

# Booking emails (silent no-op while unset)
RESEND_API_KEY=
# RESEND_FROM="Crossroads Wedding Co. <jake@crossroadsweddingco.com>"
# RESEND_NOTIFY_TO=jake@crossroadsweddingco.com

# Deposit payments (fail closed with 501 while unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Spotify playlist ingestion + track search (fails closed while unset)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Shared secret for internal tooling endpoints
ADMIN_API_TOKEN=

# Intro-call booking page (card renders nothing while unset)
NEXT_PUBLIC_BOOKING_URL=

# IG Studio
IG_STUDIO_TOKEN=
ANTHROPIC_API_KEY=
UNSPLASH_ACCESS_KEY=
